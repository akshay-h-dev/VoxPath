{
  "manifest_version": 3,
  "name": "VoxPath",
  "version": "1.3.0",
  "description": "AI Voice Interview System — fully voice-navigable interviews for visually impaired candidates",
  "action": {
    "default_popup": "popup.html",
    "default_title": "VoxPath"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["jspdf.umd.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tts",
    "downloads"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://localhost:5001/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}